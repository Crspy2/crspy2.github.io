---
import Arrow from "./Arrow.astro"
import BrandIcon from "./BrandIcon.astro"
import { contacts } from "../data/site"

const actions: Record<string, string> = {
  Discord: "Send a message",
  GitHub: "See the code",
  Telegram: "Start a chat",
}
---

<footer class="reach" aria-labelledby="reach-title">
  <h2 id="reach-title">Reach me</h2>
  <ul class="tiles">
    {
      contacts.map((c) => (
        <li>
          <a
            class="tile"
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${c.label}: ${c.handle}`}
            style={`--brand: ${c.brand}; --on: ${c.onBrand}`}
          >
            <span class="flood" aria-hidden="true" />
            <BrandIcon icon={c.icon} size={64} class="icon" />
            <span class="text">
              <span class="handle">{c.handle}</span>
              <span class="action">{actions[c.label]} <Arrow /></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="foot">© {new Date().getFullYear()} Crspy. All rights reserved.</p>
</footer>

<style>
  .reach {
    padding: var(--section-y) var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  /* Touch screens: tiles sit in brand colour, since there's no hover to reveal it. */
  .tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 340px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--brand);
    color: var(--on);
    text-decoration: none;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .handle {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 3.4vw, 3rem);
    letter-spacing: -0.02em;
  }
  .action {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 700;
  }
  .flood {
    position: absolute;
    left: 52px;
    top: 52px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    z-index: -1;
    background: var(--brand);
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.7, 0, 0.3, 1);
  }

  /* Mouse and keyboard: tiles start dark and the brand colour floods out from the logo. */
  @media (hover: hover) and (pointer: fine) {
    .tile {
      background: var(--ink-2);
      color: #fff;
      transition: color 0.3s;
    }
    .tile:hover,
    .tile:focus-visible {
      color: var(--on);
    }
    .tile:hover .flood,
    .tile:focus-visible .flood {
      transform: scale(34);
    }
  }

  .foot {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tile {
      min-height: 0;
      gap: 24px;
    }
  }
  @media (max-width: 640px) {
    .reach {
      align-items: center;
      text-align: center;
      gap: 24px;
    }
    .tiles {
      width: 100%;
    }
    .tile {
      align-items: center;
      gap: 12px;
      padding: 22px;
    }
    .tile :global(.icon) {
      width: 40px;
      height: 40px;
    }
    .handle {
      font-size: 28px;
    }
  }
</style>
