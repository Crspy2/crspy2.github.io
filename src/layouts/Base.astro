---
import { Font } from "astro:assets"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Crspy",
  description = "Crspy: staff history, what I'm up to right now, and what I build.",
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#313EE0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-discord" />
  </head>
  <body>
    <slot />
  </body>
</html>
