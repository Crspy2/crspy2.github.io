---
interface Props {
  /** "right" for in-page links, "out" (up-right) for links that leave the site. */
  dir?: "right" | "out"
}

const { dir = "right" } = Astro.props
---

<svg class="arrow" width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
  {dir === "right" ? <path d="M2 8h11M9 4l4 4-4 4" /> : <path d="M4 12 12 4M5.5 4H12v6.5" />}
</svg>

<style>
  .arrow {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.125em;
  }
</style>
