---
import { DISCORD_ID } from "../data/site"
import { getDiscordProfile } from "../lib/discord"

const profile = await getDiscordProfile()
---

<section class="now" aria-labelledby="now-title">
  <div class="copy">
    <h2 id="now-title">Right now</h2>
    <p>Live from Discord. If I'm online you'll see it here, along with whatever I'm playing or listening to.</p>
  </div>

  <article class="card" data-presence={DISCORD_ID} aria-label="Discord profile">
    <div class="banner">
      {profile.bannerUrl && <img src={profile.bannerUrl} alt="" loading="lazy" />}
    </div>
    <div class="head">
      <div class="avatar">
        {profile.avatarUrl ? <img src={profile.avatarUrl} alt="" width="80" height="80" /> : <span>C</span>}
        {profile.decorationUrl && <img class="deco" src={profile.decorationUrl} alt="" />}
        <span class="dot" aria-hidden="true"></span>
      </div>
      <p class="bubble" data-p="custom" hidden></p>
    </div>
    <div class="inner">
      <div class="who">
        <strong>{profile.displayName}</strong>
        <span>{profile.username}</span>
        <span class="sr-only" data-p="status" aria-live="polite">Connecting…</span>
      </div>

      <div class="act" data-p="game" hidden>
        <span class="label">Playing</span>
        <div class="row">
          <span class="art" data-p="game-img" aria-hidden="true"></span>
          <div class="lines">
            <strong data-p="game-name"></strong>
            <span data-p="game-detail"></span>
            <span class="elapsed" data-p="game-time"></span>
          </div>
        </div>
      </div>

      <div class="act" data-p="spotify" hidden>
        <span class="label">Listening to Spotify</span>
        <div class="row">
          <span class="art" data-p="sp-img" aria-hidden="true"></span>
          <div class="lines">
            <strong data-p="sp-song"></strong>
            <span data-p="sp-artist"></span>
            <span class="dim" data-p="sp-album"></span>
          </div>
        </div>
        <div class="track"><span data-p="sp-bar"></span></div>
        <div class="times"><span data-p="sp-now"></span><span data-p="sp-total"></span></div>
      </div>

      <p class="idle" data-p="idle" hidden></p>

      <a class="msg" href={`https://discord.com/users/${DISCORD_ID}`} target="_blank" rel="noopener noreferrer">Message @{profile.username}</a>
    </div>
  </article>
</section>

<script>
  import "../scripts/presence"
</script>

<style>
  .now {
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
  }
  .copy {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .copy p {
    max-width: 46ch;
    font-size: 18px;
    color: var(--soft);
  }

  /* Discord-native card: its own palette and type, on purpose */
  .card {
    --d-bg: #232428;
    --d-inner: #111214;
    --d-line: #2e2f34;
    --d-text: #f2f3f5;
    --d-sub: #b5bac1;
    flex: 0 0 400px;
    max-width: 100%;
    background: var(--d-bg);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
    font-family: var(--font-discord), sans-serif;
    color: var(--d-text);
    text-align: left;
  }
  .card[data-status="online"] { --dot: #23a55a; }
  .card[data-status="idle"] { --dot: #f0b232; }
  .card[data-status="dnd"] { --dot: #f23f43; }

  .banner {
    height: 140px;
    background: var(--klar);
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .head {
    position: relative;
    height: 64px;
    padding: 0 16px;
  }
  .avatar {
    position: absolute;
    top: -56px;
    left: 16px;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    border: 6px solid var(--d-bg);
    background: #5865f2;
    display: grid;
    place-items: center;
    font-size: 36px;
    font-weight: 700;
  }
  .avatar > img:first-child {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }
  .deco {
    position: absolute;
    inset: -14%;
    width: 128%;
    height: 128%;
    max-width: none;
    pointer-events: none;
  }
  .dot {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 6px solid var(--d-bg);
    background: var(--dot, #80848e);
  }
  .bubble {
    position: absolute;
    top: 10px;
    left: 124px;
    right: 16px;
    background: var(--d-inner);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #dbdee1;
    overflow-wrap: anywhere;
  }

  .inner {
    margin: 0 16px 16px;
    background: var(--d-inner);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--d-line);
  }
  .who strong { font-size: 20px; }
  .who span { font-size: 14px; color: var(--d-sub); }

  .act {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--d-line);
  }
  .label {
    font-size: 12px;
    font-weight: 700;
    color: var(--d-sub);
  }
  .row {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .art {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    flex-shrink: 0;
    background: #2b2d31 center / cover no-repeat;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-size: 13px;
    color: #dbdee1;
  }
  .lines strong { font-size: 14px; font-weight: 600; color: var(--d-text); }
  .lines span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .elapsed { color: #23a55a; }
  .dim { color: var(--d-sub); }
  .track {
    height: 4px;
    border-radius: 2px;
    background: #4e5058;
    overflow: hidden;
  }
  .track span {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1s linear;
  }
  .times {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--d-sub);
  }
  .idle {
    font-size: 14px;
    color: var(--d-sub);
  }
  .msg {
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #5865f2;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .msg:hover { background: #4752c4; }

  @media (max-width: 640px) {
    .now {
      flex-direction: column;
      text-align: center;
      gap: 32px;
    }
    .copy { flex-basis: auto; align-items: center; }
    .card { flex-basis: auto; width: 100%; max-width: 400px; }
  }
</style>
